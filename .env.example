# Discharge Planning & Follow-up Copilot — environment template (NFR-01)
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env

# --- REQUIRED: Google Gemini is the only approved model provider ---
# Obtain a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Model selection ---
# Worker/supervisor model. Flash is the cost-sensible default for a 15h capstone.
DISCHARGE_MODEL=gemini-3.6-flash
# Critic/reflection model. Kept separate so the critic can be swapped independently.
DISCHARGE_CRITIC_MODEL=gemini-3.6-flash
DISCHARGE_TEMPERATURE=0.1

# --- Reliability (NFR-07: timeouts, retries, explicit exit conditions) ---
DISCHARGE_LLM_TIMEOUT_SECONDS=60
DISCHARGE_LLM_MAX_RETRIES=3
DISCHARGE_MAX_SUPERVISOR_STEPS=12
DISCHARGE_MAX_SELF_HEAL_RETRIES=2

# --- Context engineering (NFR-08: compression for long threads) ---
# Working-memory turns kept verbatim before summarization middleware fires.
DISCHARGE_WORKING_MEMORY_WINDOW=8
DISCHARGE_COMPRESSION_TRIGGER_TOKENS=3000

# --- Memory tiers (AC-06..AC-08) ---
DISCHARGE_STATE_DIR=.state
DISCHARGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Importance-weighted eviction policy
DISCHARGE_MEMORY_TTL_DAYS=30
DISCHARGE_MEMORY_MAX_PER_NAMESPACE=50
DISCHARGE_MEMORY_IMPORTANCE_FLOOR=0.25

# --- Observability (optional, OFF by default) ---
# Token accounting is always on and needs no extra dependency — it lands in the committed
# traces and feeds scripts/metrics.py and the single-vs-multi comparison.
#
# The settings below enable OPTIONAL OpenTelemetry span export for interactive debugging.
# They require an extra install and produce no committed evidence, so they stay off:
#   pip install -e ".[observability]"   then set DISCHARGE_OTEL_ENABLED=1
#   pip install -e ".[phoenix]"         then set DISCHARGE_PHOENIX_ENABLED=1
#                                       and run: python -m phoenix.server.main serve
# Arize Phoenix is Apache-2.0 and self-hosted — nothing leaves your machine.
DISCHARGE_OTEL_ENABLED=0
DISCHARGE_PHOENIX_ENABLED=0
DISCHARGE_OTEL_ENDPOINT=http://localhost:6006/v1/traces
DISCHARGE_OTEL_PROJECT=discharge-copilot

# --- Evidence (NFR-04) ---
DISCHARGE_EVIDENCE_DIR=evidence
# NFR-05: hash synthetic PII before it reaches any log. Keep 1 unless debugging.
DISCHARGE_REDACT_PII=1
